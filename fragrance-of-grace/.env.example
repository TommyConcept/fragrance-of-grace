# Copy to .env.local for local development, and add the same four values
# in Vercel under Settings → Environment Variables.
#
# These are browser-safe. The anon key is designed to be public; what protects
# your content is the row-level security in supabase/schema.sql, which allows
# anyone to read but only a signed-in admin to write.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The username you type at /admin
VITE_ADMIN_USERNAME=Fragranceofgrace

# The email address of the single admin user you created in Supabase.
# You never type this at login — it is how the username is matched to the account.
VITE_ADMIN_EMAIL=you@example.com

# OPTIONAL — sign in with the username alone, no password typed.
#
# Set this to the password of the admin user you created in Supabase and the
# password box disappears from the login screen.
#
# Understand the trade-off before using it: this value is built into the
# JavaScript that every visitor downloads, so anyone who digs through it can
# recover it and sign in as you. It is weaker than typing a password. It is
# stronger than opening the database to anonymous writes, because saving still
# needs a real signed-in session.
#
# Use a password that is used nowhere else, and simply delete this variable
# (then redeploy) to go back to a normal password prompt.
VITE_ADMIN_PASSWORD=
